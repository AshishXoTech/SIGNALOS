APP_ENV=production
APP_PORT=8000
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=https://signal.example.gov.in

DATABASE_URL=postgresql+asyncpg://signal_user:change-me@db:5432/signal_os

AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-a-new-rotated-key
GEMINI_MODEL=gemini-3.6-flash
GROK_API_KEY=
GROK_MODEL=grok-3-mini
AI_TIMEOUT_SECONDS=8

OPENWEATHER_API_KEY=
MEDIA_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
